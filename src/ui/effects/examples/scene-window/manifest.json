{
  "manifestVersion": 1,
  "id": "example.scene-window",
  "name": "Focus window",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "entry": "effect.ts",
  "permissions": {
    "scene": {
      "anchors": [
        "bottom-right",
        "top-left"
      ],
      "maxNodes": 32,
      "maxText": 300,
      "fps": 30
    },
    "state": [
      "mode",
      "pane",
      "focus",
      "focused"
    ],
    "commands": [
      {
        "id": "focus-scroll-down",
        "title": "Scroll focus window down",
        "keys": "ctrl+d"
      },
      {
        "id": "focus-scroll-up",
        "title": "Scroll focus window up",
        "keys": "ctrl+u"
      }
    ]
  }
}
