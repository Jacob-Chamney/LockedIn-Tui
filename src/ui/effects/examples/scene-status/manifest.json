{
  "manifestVersion": 1,
  "id": "example.scene-status",
  "name": "Status card",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "entry": "effect.ts",
  "permissions": {
    "scene": {
      "anchors": [
        "top-right"
      ],
      "absolute": true,
      "maxNodes": 6,
      "maxText": 200
    },
    "state": [
      "mode",
      "pane"
    ],
    "commands": [
      {
        "id": "scene-status-toggle",
        "title": "Toggle status card",
        "keys": "space+s"
      }
    ]
  }
}
