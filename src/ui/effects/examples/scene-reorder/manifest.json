{
  "manifestVersion": 1,
  "id": "example.scene-reorder",
  "name": "Reorder panels",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "entry": "effect.ts",
  "permissions": {
    "scene": {
      "anchors": ["top-left"],
      "maxNodes": 40,
      "maxText": 512,
      "fps": 4
    },
    "state": ["focusedWindow"],
    "commands": [
      { "id": "reorder-start", "title": "Start dragging a panel" },
      { "id": "reorder-move", "title": "Move a panel over another" },
      { "id": "reorder-end", "title": "Swap the dragged panels" }
    ],
    "pointer": {
      "press": "reorder-start",
      "move": "reorder-move",
      "release": "reorder-end"
    }
  }
}
