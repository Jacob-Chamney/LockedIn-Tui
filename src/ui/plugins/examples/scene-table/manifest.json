{
  "manifestVersion": 1,
  "id": "example.scene-table",
  "name": "Session table",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "entry": "effect.ts",
  "permissions": {
    "scene": {
      "anchors": [
        "top-left"
      ],
      "maxNodes": 60,
      "maxText": 512,
      "fps": 10
    },
    "state": [
      "focusedWindow"
    ],
    "commands": [
      {
        "id": "table-next",
        "title": "Select the next session",
        "keys": "ctrl+n"
      },
      {
        "id": "table-prev",
        "title": "Select the previous session",
        "keys": "ctrl+p"
      },
      {
        "id": "table-col-next",
        "title": "Move the cell cursor right",
        "keys": "]"
      },
      {
        "id": "table-col-prev",
        "title": "Move the cell cursor left",
        "keys": "["
      },
      {
        "id": "table-open",
        "title": "Open the selected cell",
        "keys": "o"
      },
      {
        "id": "table-select-start",
        "title": "Start a cell selection"
      },
      {
        "id": "table-select-move",
        "title": "Extend the cell selection"
      },
      {
        "id": "table-select-end",
        "title": "Finish the cell selection"
      }
    ],
    "pointer": {
      "press": "table-select-start",
      "move": "table-select-move",
      "release": "table-select-end"
    }
  }
}
