{
  "manifestVersion": 1,
  "id": "example.scene-dashboard",
  "name": "Session dashboard",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "entry": "effect.ts",
  "permissions": {
    "scene": {
      "anchors": [
        "top-left"
      ],
      "maxNodes": 60,
      "maxText": 512,
      "fps": 10
    },
    "state": [
      "focusedWindow"
    ],
    "commands": [
      {
        "id": "dashboard-next",
        "title": "Select the next session",
        "keys": "ctrl+n"
      },
      {
        "id": "dashboard-prev",
        "title": "Select the previous session",
        "keys": "ctrl+p"
      },
      {
        "id": "dashboard-open",
        "title": "Open the selected session",
        "keys": "o"
      },
      {
        "id": "dashboard-pin",
        "title": "Pin or unpin the selected session",
        "keys": "p"
      },
      {
        "id": "dashboard-copy",
        "title": "Copy the selected session",
        "keys": "y"
      },
      {
        "id": "dashboard-click",
        "title": "Select a table cell"
      },
      {
        "id": "dashboard-hover",
        "title": "Track the hovered table cell"
      },
      {
        "id": "dashboard-wheel",
        "title": "Scroll the session table"
      }
    ],
    "clipboard": true,
    "pointer": {
      "click": "dashboard-click",
      "hover": "dashboard-hover",
      "wheel": "dashboard-wheel"
    }
  }
}
