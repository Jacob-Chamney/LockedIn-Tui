{
  "manifestVersion": 1,
  "id": "example.scene-workbench",
  "name": "Session workbench",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "entry": "effect.ts",
  "permissions": {
    "scene": {
      "anchors": ["top-left"],
      "maxNodes": 60,
      "maxText": 512,
      "fps": 4
    },
    "state": ["focusedWindow"],
    "commands": [
      { "id": "workbench-next", "title": "Select the next session", "keys": "ctrl+n" },
      { "id": "workbench-prev", "title": "Select the previous session", "keys": "ctrl+p" }
    ]
  }
}
