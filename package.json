{
  "name": "lockedin-desktop",
  "version": "2026.11.27",
  "private": true,
  "type": "module",
  "description": "A keyboard-first desktop workspace for learning and focused work.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jacob-Chamney/LockedIn-Tui.git"
  },
  "homepage": "https://github.com/Jacob-Chamney/LockedIn-Tui",
  "bugs": {
    "url": "https://github.com/Jacob-Chamney/LockedIn-Tui/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel --no-isolate --path-ignore-patterns='spikes/**' tests",
    "test:unit": "bun test --parallel --no-isolate tests/unit tests/contract tests/integration tests/invariant",
    "test:changed": "bun test --parallel --no-isolate --changed",
    "test:branch": "bun test --parallel --no-isolate --changed=dev",
    "test:watch": "bun test --watch",
    "test:serial": "bun test --max-concurrency=1 --path-ignore-patterns='spikes/**' tests",
    "check": "bun run scripts/check.ts",
    "check:ci": "bun run scripts/check.ts --ci",
    "check:desktop": "./scripts/desktop-check.sh",
    "build": "bun run scripts/desktop-build.sh"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.82",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "ai": "7.0.159",
    "fflate": "0.8.3",
    "shiki": "4.6.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "license": "AGPL-3.0-only"
}
